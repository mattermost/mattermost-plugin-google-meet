{
  "private": true,
  "scripts": {
    "build": "webpack --mode=production",
    "build:watch": "webpack --mode=production --watch",
    "debug": "webpack --mode=none",
    "debug:watch": "webpack --mode=development --watch",
    "lint": "eslint --ignore-pattern node_modules --ignore-pattern dist --ext=.js,.jsx,tsx,ts . --quiet --cache",
    "fix": "eslint --ignore-pattern node_modules --ignore-pattern dist --ext=.js,.jsx,tsx,ts . --quiet --fix --cache",
    "test": "jest --forceExit --detectOpenHandles --verbose",
    "test:watch": "jest --watch",
    "test-ci": "jest --forceExit --detectOpenHandles --maxWorkers=2",
    "check-types": "tsc"
  },
  "devDependencies": {
    "@babel/cli": "7.25.6",
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.26.9",
    "@babel/preset-react": "7.26.3",
    "@babel/preset-typescript": "7.26.0",
    "@babel/runtime": "7.25.6",
    "@emotion/babel-preset-css-prop": "11.2.0",
    "@emotion/react": "11.14.0",
    "@mattermost/client": "11.1.0",
    "@mattermost/eslint-plugin": "1.1.0-0",
    "@mattermost/types": "11.1.0",
    "@testing-library/jest-dom": "6.6.3",
    "@types/babel__core": "7.20.5",
    "@types/babel__template": "7.4.4",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.6",
    "@types/react-router-dom": "5.1.5",
    "@types/react-transition-group": "4.4.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "babel-loader": "9.1.2",
    "babel-plugin-formatjs": "10.3.7",
    "babel-plugin-typescript-to-proptypes": "2.1.0",
    "css-loader": "6.5.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "4.6.0",
    "file-loader": "6.2.0",
    "identity-obj-proxy": "3.0.0",
    "isomorphic-fetch": "3.0.0",
    "jest": "29.7.0",
    "jest-canvas-mock": "2.3.1",
    "jest-environment-jsdom": "30.2.0",
    "jest-junit": "13.0.0",
    "sass": "1.52.3",
    "sass-loader": "13.0.0",
    "style-loader": "3.3.1",
    "webpack": "5.95.0",
    "webpack-cli": "5.1.4"
  },
  "dependencies": {
    "core-js": "3.26.0",
    "mattermost-redux": "11.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "9.2.0",
    "redux": "5.0.1",
    "typescript": "5.7.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/non_npm_dependencies/"
    ],
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}"
    ],
    "coverageReporters": [
      "lcov",
      "text-summary"
    ],
    "moduleNameMapper": {
      "^.+\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "identity-obj-proxy",
      "^.+\\.(css|less|scss)$": "identity-obj-proxy",
      "^.*i18n.*\\.(json)$": "<rootDir>/tests/i18n_mock.json",
      "^bundle-loader\\?lazy\\!(.*)$": "$1"
    },
    "moduleDirectories": [
      "src",
      "node_modules",
      "non_npm_dependencies"
    ],
    "reporters": [
      "default",
      "jest-junit"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!react-native|react-router|mattermost-webapp)"
    ],
    "setupFiles": [
      "jest-canvas-mock"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.tsx"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost:8065"
    }
  }
}
