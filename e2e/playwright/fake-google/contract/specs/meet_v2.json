      "type": "object",
      "properties": {
        "meetingCode": {
          "type": "string"
        },
        "meetingUri": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Transcript": {
      "type": "object",
      "properties": {
        "docsDestination": {
          "$ref": "DocsDestination"
        },
        "endTime": {
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "type": "string"
        },
        "startTime": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "type": "string",
          "enum": [
            "STATE_UNSPECIFIED",
            "STARTED",
            "ENDED",
            "FILE_GENERATED"
