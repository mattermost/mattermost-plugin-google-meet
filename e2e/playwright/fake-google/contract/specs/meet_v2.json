          }
        }
      },
      "additionalProperties": false
    },
    "ListSmartNotesResponse": {
      "type": "object",
      "properties": {
        "nextPageToken": {
          "type": "string"
        },
        "smartNotes": {
          "type": "array",
          "items": {
            "$ref": "SmartNote"
          }
        }
      },
      "additionalProperties": false
    },
    "ListTranscriptEntriesResponse": {
